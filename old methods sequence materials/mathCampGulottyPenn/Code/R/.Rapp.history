library(ggplot2)#
#
# Part 1: Making a perspective plot#
#
x <- seq(0, 1,.01)#
#
y <- seq(0, 1,.01)#
#
z<- outer(x, y, function(x,y){x + y})#
#
pdf("roof.pdf")#
persp(x, y, z)#
dev.off()#
#
# Part 2: Simulate marginal distribution:#
#
#Simulate the marginal with the inverse cdf:#
udrawx<-runif(10000)#
#
invcdfx<- function(y){1/2*(sqrt(8*y+1)-1)}#
#
xdraws<-invcdfx(udrawx)#
#
hist(xdraws)#
#
#Part 3: Simulate the conditional with the inverse cdf:#
#
udrawy<-runif(10000)#
#
invcdfygivenx<-function(xdraws, udrawys){sqrt(xdraws^2+2*xdraws*udrawys+udrawys)-xdraws}#
#
ydraws<-invcdfygivenx(xdraws, udrawy)#
#
hist(ydraws)#
#
#Part 4: Simulate the conditional with the inverse cdf:#
#
cov(xdraws, ydraws)#
cor(xdraws, ydraws)#
#
summary(lm(ydraws~xdraws))#
#
pdf("~/Dropbox/mathCamp/BobbyLectures/5-CovarianceCorrelation/ConditionalExp.pdf")#
plot(xdraws, ydraws, cex=.1,pch=10)#
lines(x, (2+3*x)/(3+6*x), lty=2)#
abline(lm(ydraws~xdraws),lty=3)#
abline(a=84/132, b=-1/11)#
dev.off()#
#
pdf("~/Dropbox/mathCamp/BobbyLectures/5-CovarianceCorrelation/ConditionalExpZoom.pdf")#
plot(xdraws, ydraws, cex=.1,pch=10, ylim=c(.5,.7))#
lines(x, (2+3*x)/(3+6*x), lty=2)#
abline(a=84/132, b=-1/11)#
abline(lm(ydraws~xdraws),lty=3)#
dev.off()#
df<-data.frame(x=xdraws, y=ydraws)#
#
ggplot(df, aes(x, y))+#
geom_point(alpha=.2, size=.2)+#
geom_abline(intercept=84/132, slope=-1/11)+#
geom_line(aes(x, (2+3*x)/(3+6*x)), lty=2)+#
geom_smooth(method="lm", se=F,lty=4)+#
coord_cartesian(ylim=c(.5,.75))
ggsave("HW1CEF.png")
