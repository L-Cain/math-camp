library(tidyverse)
dta<-read_csv("~/Downloads/datapca.csv")
dta
dtamat<-scale(dta[,-1])
dtamat
dtamatcov<-t(dtamat)%*%dtamat/(nrow(dtamat)-1)
dtaeigens<-eigen(dtamatcov)
eigenvalues <-  dtaeigens$values#
#
eigenvectors <- Udtaeigens$vectors
plot(1:51, eigenvalues, type="o", log="y", main="Magnitudes")
plot(13, eigenvalues, type="o", log="y", main="Magnitudes")
plot(1:3, eigenvalues, type="o", log="y", main="Magnitudes")
sum(eigenvalues[1:2])/sum(eigenvalues)
dtamatcov_score<-dtamatcov%*%eigenvectors
dtamatcov_score<-dtamatcov%*%eigenvectors
eigenvectors <- dtaeigens$vectors
dtamatcov_score<-dtamatcov%*%eigenvectors
plot(dtamatcov_score[,1],dtamatcov_score[,2], pch="" )#
text(dtamatcov_score[,1],dtamatcov_score[,2], #
     labels=rownames(dtamatcov_score))
autoplot(pca_res, data = dta, loadings = TRUE)
