###House Distribution#
library(ggplot2)#
x<-seq(0,2,by=.001)#
pdfpt1<-3/8+x/4#
#
pdfpt2<-.5+3/8-x/4#
#
df<-data.frame(cbind(x, pdf=ifelse(x<1,pdfpt1, pdfpt2)))#
#
ggplot(df, aes(x, pdf))+geom_line()
ggplot(df, aes(x, pdf))+geom_line()+ylimc(0,1)
ggplot(df, aes(x, pdf))+geom_line()+ylim(c(0,1))
ggplot(df, aes(x, pdf))+geom_line()+ylim(c(0,1))+geom_segment(x=0,xend=3/8)
ggplot(df, aes(x, pdf))+geom_line()+ylim(c(0,1))+geom_segment(x=0,yend=3/8)
ggplot(df, aes(x, pdf))+geom_line()+ylim(c(0,1))+geom_segment(x=0,xend=0, y=0,yend=3/8)
ggplot(df, aes(x, pdf))+geom_line()+ylim(c(0,1))+geom_segment(x=0,xend=0, y=0,yend=3/8)+geom_segment(x=2,xend=2, y=0,yend=3/8)
ggplot(df, aes(x, pdf))+geom_line()+ylim(c(0,1))+geom_segment(x=0,xend=0, y=0,yend=3/8)+geom_segment(x=2,xend=2, y=0,yend=3/8)+theme_bw()
ggsave("housedist.png")
