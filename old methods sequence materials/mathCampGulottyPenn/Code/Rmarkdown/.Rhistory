zipcheck<-function(zip){
isfivedigit <- as.numeric(zip)>9999&  as.numeric(zip)< 100000
propout<-sum(isfivedigit, na.rm=T)/ length(isfivedigit)
return(propout)
}
zipcheck(c(10,10000,60605))
abs(-3)
zipcheck<-function(zip){
isfivedigit <- abs(as.numeric(zip))>9999&  abs(as.numeric(zip))< 100000
propout<-sum(isfivedigit, na.rm=T)/ length(isfivedigit)
return(propout)
}
zipcheck(c(10,10001,60605,-40304))
