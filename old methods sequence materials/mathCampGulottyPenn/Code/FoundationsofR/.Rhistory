dfdist<- data.frame( Lat=c(10,20,103,40,50), Lon=c(3,-10,2,3,4), cities=c("a","b","c","d","e"))
function(Lat, Lon, Lat1, Lon1){
out<-sqrt((Lat-Lat1)^2+(Lon-Lon1)^2)
return(out)
}
distanceCalc<-function(Lat, Lon, Lat1, Lon1){
out<-sqrt((Lat-Lat1)^2+(Lon-Lon1)^2)
return(out)
}
distanceCalc(dfdist$Lat, dfdist$Lon, dfdist$Lat, dfdist$Lon)
distanceCalc<-function(Lat, Lon, Lat1, Lon1){
out<-sqrt((Lat[1]-Lat1)^2+(Lon[1]-Lon1)^2)
return(out)
}
distanceCalc(dfdist$Lat, dfdist$Lon, dfdist$Lat, dfdist$Lon)
indexeddist<-  function(i){
sqrt((Lat[i]-Lat1)^2+(Lon[i]-Lon1)^2)}
distanceCalc<-function(Lat, Lon, Lat1, Lon1){
indexeddist<-  function(i){
sqrt((Lat[i]-Lat1)^2+(Lon[i]-Lon1)^2)}
out<-indexeddist(1)
return(out)
}
distanceCalc(dfdist$Lat, dfdist$Lon, dfdist$Lat, dfdist$Lon)
distanceCalc<-function(Lat, Lon, Lat1, Lon1){
indexeddist<-  function(i){
sqrt((Lat[i]-Lat1)^2+(Lon[i]-Lon1)^2)}
out<-indexeddist(1:4)
return(out)
}
distanceCalc(dfdist$Lat, dfdist$Lon, dfdist$Lat, dfdist$Lon)
distanceCalc<-function(Lat, Lon, Lat1, Lon1){
indexeddist<-  function(i){
sqrt((Lat[i]-Lat1)^2+(Lon[i]-Lon1)^2)}
out<-sapply(1:4, indexeddist)
return(out)
}
distanceCalc(dfdist$Lat, dfdist$Lon, dfdist$Lat, dfdist$Lon)
rowmean(distanceCalc(dfdist$Lat, dfdist$Lon, dfdist$Lat, dfdist$Lon))
