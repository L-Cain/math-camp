sampler<-function(n, dist){#
#
samples <- rnorm(n, mean=3, 12^2)#
pdraw <- abs(mean(samples)-dist)#
return(pdraw)#
#
}#
out<-c()#
#
for(i in 1:100){# Test each sample size from 1 to 100#
#
sampledistance<-mean(replicate(2000, sampler(i, 3)))#
out[i]<-sampledistance<3#
#
}#
#
which(out>=.95)
out
