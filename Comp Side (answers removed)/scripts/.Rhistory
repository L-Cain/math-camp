#| fig-align: center
#| fig-width: 6
#| fig-height: 4
n <- 1500
dat <- tibble(x = rnorm(n, mean = 2)) |>
mutate(mu = 3*x + 8*x^2 - 3*x^3,
y = rnorm(n, mean = mu, sd = 3))
p <- dat |>
ggplot(aes(x = x, y = y)) +
geom_point(alpha = .5, size = 2) +
theme_bw() +
geom_line(aes(y = mu), col = "red", lwd = 2) +
coord_cartesian(xlim = c(0, 2.75),
ylim = c(-10, 25))
p
