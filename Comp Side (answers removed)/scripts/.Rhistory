?case_when
for (num in numbers) {
message <- case_when(
num < 3     ~ "that's a small number",
3 < num < 8 ~ "that's a medium number",
for (num in numbers) {
message <- case_when(
num > 8     ~ "that's a small number",
num > 3 ~ "that's a medium number",
num > 0     ~ "that's a BIG number"
)
round(num, 2) %>%
paste0(., '? ', message) %>%
print(.)
}
for (num in numbers) {
message <- case_when(
num > 8     ~ "that's a BIG number",
num > 3     ~ "that's a medium number",
num > 0     ~ "that's a small number"
)
round(num, 2) %>%
paste0(., '? ', message) %>%
print(.)
}
#what's the start time
start_time<-Sys.time()
#while it's less than 30 seconds from start time...
while(Sys.time() < start_time + seconds(30)){
#calculate remaining time
remaining<-(start_time+seconds(30)) - Sys.time()
#insert that into a message and print
paste(remaining)%>%
as.numeric()%>%
round(.,
2)%>%
paste0('I am in timeout for ', ., ' more seconds')%>%
print()
}
rm(list = ls())
library(tidyverse)
#----Random Sampling----
#Often, we want to something "randomly". Computers are deterministic(ish), but we can get close
#They'll do complex math on a starting value in a chaotic way to reach pseudo-random numbers. Specify a "seed", get the same pseudo-random process every time:
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
sample(fruit,
size = 3)
sample(fruit,
size = 3)
#So far we've assumed an equal probability of each element. We can be explicit about this:
sample(c("Head", "Tail"),
size = 20,
prob = c(.5, .5),
replace = TRUE)
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
set.seed(60637)
#To take a random series from a vector
fruit<-c('apple','banana','pear','grape')
sample(fruit,
size = 3)
#So far we've assumed an equal probability of each element. We can be explicit about this:
sample(c("Head", "Tail"),
size = 20,
prob = c(.5, .5),
replace = TRUE)
#And we can weight one outcome more (axioms of probability apply):
sample(c("Head", "Tail"),
size = 20,
prob = c(0,1),
replace = TRUE)
