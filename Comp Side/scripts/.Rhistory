numbers<-runif(n= 20,
min = 0,
max = 10)
for (num in numbers){
#discern  message
if (num < 3){
message<-"that's a small number"
} else if (num >8){
message<-"That's a BIG number!"
} else {
message<-"That's a medium number"
}
#round number
round(num,
2)%>%
#concatenate
paste0(.,'? ',message)%>%
#print it
print(.)
}
